{
    "consent_requirements": {
        "required": true,
        "purpose": "AI-assisted HR screening and interview evaluation",
        "candidate_notice_required": true,
        "human_review_available": true
    },
    "fairness_controls": {
        "review_required": true,
        "demographic_signals_excluded": true,
        "score_difference_threshold": 15
    },
    "demographic_signals_excluded": [
        "gender",
        "sex",
        "age",
        "date of birth",
        "religion",
        "race",
        "ethnicity",
        "caste",
        "marital status",
        "disability",
        "nationality",
        "political affiliation"
    ],
    "explainability_controls": {
        "enabled": true,
        "show_score_components": true,
        "show_decision_reason": true,
        "human_review_required_for_low_confidence": true
    },
    "data_retention_controls": {
        "enabled": true,
        "default_retention_days": 90,
        "delete_after_expiry": true,
        "candidate_deletion_request_supported": true
    },
    "readiness_status": "READY_FOR_HUMAN_COMPLIANCE_REVIEW"
}
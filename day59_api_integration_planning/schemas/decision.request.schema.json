    "job_id",
    "stage_results",
    "policy_version"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "stage_results": {
      "type": "array"
    },
    "policy_version": {
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeParseRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "document_uri",
    "document_type",
    "idempotency_key"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "document_uri": {
      "type": "string",
      "format": "uri"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "pdf",
        "docx"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8
    },
    "consent_reference": {
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATSScoreResponse",
  "type": "object",
  "required": [
    "request_id",
    "candidate_id",
    "job_id",
    "score",
    "matched_skills",
    "missing_skills",
    "model_version"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "matched_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "model_version": {
      "type": "string"
    }
  }
}

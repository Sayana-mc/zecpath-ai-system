  "required": [
    "candidate_id",
    "job_id",
    "resume_profile",
    "required_skills"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "resume_profile": {
      "type": "object"
    },
    "required_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

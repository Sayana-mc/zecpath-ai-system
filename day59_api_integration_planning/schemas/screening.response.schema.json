{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreeningResponse",
  "type": "object",
  "required": [
    "request_id",
    "candidate_id",
    "job_id",
    "status",
    "evidence",
    "review_required"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "needs_review",
        "insufficient_data"
      ]
    },
    "evidence": {
      "type": "array"
    },
    "review_required": {
      "const": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zecpath.example/schemas/job-description.schema.json",
  "title": "ZecPath job opening",
  "type": "object",
  "required": [
    "opening_id",
    "title",
    "description",
    "required_skills",
    "preferred_skills",
    "status"
  ],
  "properties": {
    "opening_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 2, "maxLength": 160},
    "description": {"type": "string", "maxLength": 20000},
    "required_skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "preferred_skills": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 80}
    },
    "minimum_education": {"type": ["string", "null"], "maxLength": 160},
    "minimum_years_experience": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 80
    },
    "status": {"enum": ["OPEN", "CLOSED"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
